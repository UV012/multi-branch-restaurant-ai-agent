# ====================================================================
# Multi-Branch Restaurant AI Agent System - Environment Configuration
# ====================================================================

# Database: Strictly PostgreSQL (local Docker or free-tier cloud instance e.g. Neon, Supabase, Render)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/restaurant_ai

# Ollama DeepSeek R1 8B endpoint (Local Ollama reached via free tunnel like ngrok or Cloudflare Tunnel)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# Authentication / Security
JWT_SECRET=restaurant_ai_super_secret_jwt_key_change_in_production_32char_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
